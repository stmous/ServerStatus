        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "serverroom-influx"
          },
          "query": "from(bucket: \"serverroom_raw\")\n  |> range(start: -15m)\n  |> filter(fn: (r) => r._measurement == \"environment\" and r._field == \"temperature\" and r.location == \"server-room\")\n  |> last()\n  |> keep(columns: [\"_time\", \"_value\"])",
