    {
      "id": 5,
      "type": "timeseries",
      "title": "Temperature",
      "datasource": {
        "type": "influxdb",
        "uid": "serverroom-influx"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "serverroom-influx"
          },
          "query": "span = uint(v: v.timeRangeStop) - uint(v: v.timeRangeStart)\nuseDownsampled = span > uint(v: 172800000000000)\nsrc = if useDownsampled then \"serverroom_5m\" else \"serverroom_raw\"\nfrom(bucket: src)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"environment\" and r._field == \"temperature\" and r.location == \"server-room\")\n  |> filter(fn: (r) => not exists r.agg or r.agg == \"mean\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> keep(columns: [\"_time\", \"_value\"])",
          "hide": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "decimals": 1,
          "displayName": "Temperature",
          "color": {
            "mode": "fixed",
            "fixedColor": "#F2CC0C"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "orange",
                "value": 27.0
              },
              {
                "color": "red",
                "value": 30.0
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": 300000,
            "axisSoftMin": 18,
            "axisSoftMax": 32.0,
            "thresholdsStyle": {
              "mode": "line+area"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": false,
          "displayMode": "hidden",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    },
