# /etc/serverroom-monitor/secrets.env  (owner root, mode 600)
#
# The installer fills in anything it can generate (InfluxDB tokens and
# passwords, the Grafana admin password) and prompts for the rest.
# After editing, run: sudo /opt/serverroom-monitor/scripts/apply-config.sh
# Never commit this file.

# --- generated by install.sh ---------------------------------------------
GRAFANA_ADMIN_PASSWORD=
INFLUX_ADMIN_PASSWORD=
INFLUX_OPERATOR_TOKEN=
INFLUX_WRITE_TOKEN=
INFLUX_READ_TOKEN=

# --- notification channels (only needed when enabled in config.yaml) --------
TELEGRAM_BOT_TOKEN=
SMTP_PASSWORD=
WEBHOOK_URL=
DEADMAN_URL=

# --- optional -------------------------------------------------------------
# Overrides heartbeat.url in config.yaml
HEARTBEAT_URL=
# Pre-authorised key for unattended `tailscale up` (tskey-auth-...)
TAILSCALE_AUTHKEY=
